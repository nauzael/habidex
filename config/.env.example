# ─── App ────────────────────────────────────────────────────────────────────────
APP_NAME=Hotel Platform
APP_ENV=development
APP_DEBUG=true
PORT=3000
NODE_ENV=development

# ─── Database (PostgreSQL — Neon) ──────────────────────────────────────────────
# Neon: https://neon.tech
# Create a project → copy the connection string (with pooler, ends in neon.tech)
# Example: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/hotel_platform?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_SMtp28OqKZDd@ep-rapid-truth-adr2gf8n-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=true

# ─── Redis (Upstash) ───────────────────────────────────────────────────────────
# Upstash: https://upstash.com
# Create a Redis database → copy the UPSTASH_REDIS_REST_URL
# Example: redis://default:pass@xxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
REDIS_PREFIX=hotel:

# ─── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=hotel-platform

# ─── External Services ─────────────────────────────────────────────────────────
# Meta WhatsApp Cloud API (OpenWA)
OPENWA_URL=http://openwa:2785
OPENWA_API_KEY=

# Resend (email)
RESEND_API_KEY=

# Stripe (pagos internacionales)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MICRO=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_PREMIUM=

# PayU / Epayco / Wompi (pagos locales Colombia)
PAYU_API_KEY=
PAYU_API_LOGIN=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=

# ─── API ───────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3000/api
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Logging & Observability ───────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json
SENTRY_DSN=

# ─── Feature Flags ─────────────────────────────────────────────────────────────
FF_DYNAMIC_PRICING=false
FF_BULK_IMPORT=true
FF_OFFLINE_MODE=true
FF_MULTI_CURRENCY=false

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_BURST=50

# ─── Tenant Defaults ───────────────────────────────────────────────────────────
DEFAULT_CURRENCY=COP
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_LOCALE=es-CO

# ─── OTA Integrations ──────────────────────────────────────────────────────────
# Booking.com
BOOKING_API_USERNAME=
BOOKING_API_PASSWORD=

# Expedia
EXPEDIA_API_KEY=
EXPEDIA_API_SECRET=
