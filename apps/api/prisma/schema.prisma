// ─── Datasource ──────────────────────────────────────────────────────────────
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Generator ───────────────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

// ─── Enums ───────────────────────────────────────────────────────────────────
enum UserRole {
  ADMIN
  MANAGER
  RECEPTIONIST
  OWNER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum Season {
  LOW
  MID
  HIGH
  PEAK
}

enum BookingChannel {
  DIRECT
  BOOKING_COM
  EXPEDIA
  AIRBNB
  DESPEGAR
  OTRO
}

// ─── Models ──────────────────────────────────────────────────────────────────

/// Hotel / Property
model Hotel {
  id        String  @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  timezone  String  @default("America/Bogota")
  currency  String  @default("COP")
  isFounder Boolean @default(false)
  features  Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  roomTypes RoomType[]
  inventory Inventory[]
  rates     Rate[]
  bookings  Booking[]

  @@map("hotels")
}

/// User (staff / owner)
model User {
  id       String   @id @default(uuid())
  hotelId  String
  name     String
  email    String   @unique
  password String
  role     UserRole @default(RECEPTIONIST)
  active   Boolean  @default(true)

  createdAt DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("users")
}

/// Room type / category
model RoomType {
  id          String  @id @default(uuid())
  hotelId     String
  name        String
  description String?
  basePrice   Decimal @db.Decimal(10, 2)
  maxGuests   Int     @default(2)
  totalRooms  Int     @default(1)
  amenities   Json    @default("[]")
  sortOrder   Int     @default(0)

  hotel     Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inventory Inventory[]
  rates     Rate[]
  bookings  Booking[]

  @@map("room_types")
}

/// Daily room inventory
model Inventory {
  id             String   @id @default(uuid())
  hotelId        String
  roomTypeId     String
  date           DateTime @db.Date
  availableRooms Int
  totalRooms     Int
  version        Int      @default(1)

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([hotelId, roomTypeId, date])
  @@map("inventory")
}

/// Daily rate for a room type
model Rate {
  id         String   @id @default(uuid())
  hotelId    String
  roomTypeId String
  date       DateTime @db.Date
  price      Decimal  @db.Decimal(10, 2)
  season     Season   @default(MID)
  version    Int      @default(1)

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([hotelId, roomTypeId, date])
  @@map("rates")
}

/// Booking / reservation
model Booking {
  id               String         @id @default(uuid())
  hotelId          String
  roomTypeId       String
  guestName        String
  guestEmail       String?
  guestPhone       String?
  checkIn          DateTime       @db.Date
  checkOut         DateTime       @db.Date
  status           BookingStatus  @default(PENDING)
  channel          BookingChannel @default(DIRECT)
  channelBookingId String?
  totalAmount      Decimal        @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime       @default(now())

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([hotelId, checkIn, checkOut])
  @@index([channelBookingId])
  @@map("bookings")
}
